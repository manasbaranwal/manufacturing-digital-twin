* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  color: #e2e8f0;
  background: #081120;
  line-height: 1.5;
  font-weight: 400;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: linear-gradient(180deg, #0b1220 0%, #101a2a 100%);
}

button, input, select {
  font: inherit;
}

#root {
  width: 100%;
}

.app-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 20px 48px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}

.eyebrow {
  margin: 0;
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #7dd3fc;
}

h1 {
  margin: 8px 0 0;
  font-size: clamp(2rem, 4vw, 3rem);
}

.status-pill {
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(74, 222, 128, 0.15);
  color: #86efac;
  border: 1px solid rgba(134, 239, 172, 0.3);
  font-weight: 700;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
  margin-bottom: 24px;
}

.metric-card {
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 18px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.2);
}

.metric-card span {
  color: #cbd5e1;
  font-size: 0.9rem;
}

.metric-card strong {
  font-size: clamp(1.5rem, 3vw, 2.2rem);
}

.accent-blue { border-top: 4px solid #38bdf8; }
.accent-green { border-top: 4px solid #4ade80; }
.accent-orange { border-top: 4px solid #fbbf24; }
.accent-purple { border-top: 4px solid #a78bfa; }

.content-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
}

.panel {
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 18px;
  padding: 20px;
}

.panel h2 {
  margin-top: 0;
  margin-bottom: 18px;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  text-align: left;
  padding: 12px 10px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

th {
  color: #93c5fd;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.alert-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.alert {
  display: flex;
  gap: 12px;
  padding: 12px;
  border-radius: 12px;
  background: rgba(15, 118, 110, 0.08);
  border: 1px solid rgba(148, 163, 184, 0.12);
}

.alert p {
  margin: 4px 0 0;
  color: #dbeafe;
}

.severity {
  display: inline-flex;
  min-width: 58px;
  justify-content: center;
  align-items: center;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 700;
  background: rgba(248, 250, 252, 0.08);
}

.alert-low .severity { background: rgba(134, 239, 172, 0.15); color: #bbf7d0; }
.alert-medium .severity { background: rgba(251, 191, 36, 0.15); color: #fde68a; }
.alert-high .severity { background: rgba(248, 113, 113, 0.15); color: #fecaca; }

.loading {
  padding: 24px;
  text-align: center;
  color: #cbd5e1;
}

@media (max-width: 760px) {
  .content-grid {
    grid-template-columns: 1fr;
  }

  th, td {
    padding: 10px 8px;
    font-size: 0.85rem;
  }
}
